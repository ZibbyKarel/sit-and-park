// Prisma schema for Sit & Park.
//
// This file mirrors the contract's entity schemas
// (`libs/sit-and-park/contract/src/schemas/entities.ts`) field for field: same names, same
// nullability, same enum members. The contract is the single source of truth for
// data shapes; where storage has to differ, the difference is deliberate and
// documented in `doc/backend.md`.
//
// Connection URLs live in `prisma.config.ts` at the repo root — Prisma 7
// deprecated `url` in the datasource block.

generator client {
  provider = "prisma-client"

  // Prisma 7 requires an explicit output; the client is no longer written into
  // node_modules. It lands inside this lib so it is versioned with the schema
  // that produced it and is reachable from `@sit-and-park/database`.
  output = "../src/generated/prisma"

  // The whole backend (apps/sit-and-park/api, Jest via ts-jest) is CommonJS, so the
  // generated client has to be too — the default is ESM.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// --- Enumerations ----------------------------------------------------------
// Members must stay identical to the tuples in
// `libs/sit-and-park/shared-types/src/lib/domain-constants.ts`, which the contract's Zod
// enums are built from. `libs/sit-and-park/database/src/lib/schema-contract-parity.spec.ts`
// (describe: "Prisma enums mirror the domain enumerations") fails if they drift.

/// Parking spot group. IT spots are reserved for the IT department.
enum ParkingGroup {
  IT
  SHARED
}

/// Application role. There are exactly two; there is no per-resource ACL.
enum UserRole {
  USER
  ADMIN
}

/// Admin override of the reservation window (see decision 0004).
enum ReservationLockMode {
  AUTO
  FORCE_OPEN
  FORCE_LOCKED
}

/// Closed list of audited actions (see decision 0016).
enum AuditLogAction {
  RESERVATION_CREATED
  RESERVATION_CANCELLED
  RESERVATION_CANCELLED_BY_ADMIN
  WAITLIST_PROMOTED
  USER_UPDATED
  SPOT_UPDATED
  RESERVATION_WINDOW_UPDATED
  WAITLIST_JOINED
  RESERVATION_CREATED_BY_ADMIN
  WAITLIST_JOINED_BY_ADMIN
  RESERVATION_LIMITS_UPDATED
  TIMED_RESERVATION_CREATED
  TIMED_RESERVATION_CANCELLED
  DESK_RESERVATION_CREATED
  DESK_RESERVATION_CANCELLED
  DESK_RESERVATION_CANCELLED_BY_ADMIN
  DESK_RELEASED
  DESK_RELEASE_CANCELLED
  DESK_APPROVAL_REQUESTED
  DESK_APPROVAL_DECIDED
  DESK_UPDATED
  HIVE_UPDATED
  OFFICE_UPDATED
  ZONE_UPDATED
  EMPLOYEE_SYNC_APPLIED
  EMPLOYEE_SYNC_SETTINGS_UPDATED
  USER_DEACTIVATED
}

/// Lifecycle of a request to book a hive desk without direct access. A request
/// its author withdraws is deleted, so there is no `CANCELLED` (decision 0332).
enum DeskApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether an employee-sync run wrote anything (`LIVE`) or only reported what
/// it would have done (`DRY`).
enum EmployeeSyncMode {
  DRY
  LIVE
}

/// Outcome of an employee-sync run. A `REJECTED` run changed nothing.
enum EmployeeSyncStatus {
  OK
  REJECTED
}

// --- Entities --------------------------------------------------------------

/// An employee. Offboarding deactivates a user (`active = false`) instead of
/// deleting the row, so foreign keys from reservations and the audit log stay
/// intact.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  /// Czech licence plate ("SPZ"); optional, used to identify a parked car.
  licensePlate String?
  role         UserRole @default(USER)
  /// Subject claim of the Okta token; the identity we provision against.
  oktaId       String   @unique
  active       Boolean  @default(true)
  /// Secret in the personal ICS feed URL; regenerating it invalidates the old URL.
  icsToken     String   @unique

  /// First choice when bulk booking. Never applied to a single-day reservation.
  /// Nullable FK: retiring a spot must not delete or block the user.
  preferredParkingSpotId String?      @db.Uuid
  preferredParkingSpot   ParkingSpot? @relation("UserPreferredSpot", fields: [preferredParkingSpotId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// First choice when bulk booking desks. Nullable FK, like the preferred spot.
  preferredDeskId String? @db.Uuid
  preferredDesk   Desk?   @relation("UserPreferredDesk", fields: [preferredDeskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Office the user works in; scopes which desks and spots they see. Nullable:
  /// a just-provisioned account has none until an admin or the sync sets it.
  officeId String? @db.Uuid
  office   Office? @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Employee id in HiBob; the key the employee sync matches on before e-mail.
  hibobId       String?   @unique
  /// Never touched by the employee sync (decision 0329). Accounts outside the
  /// company domain are treated the same way whatever this says.
  manualAccount Boolean   @default(false)
  /// When the account was deactivated. `active` stays the switch the auth guard
  /// reads; this only records when it was flipped.
  deactivatedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  auditLogs       AuditLog[]

  ownedHives           Hive[]
  hiveMembership       HiveMembership?
  permanentDesk        Desk?                 @relation("DeskPermanentAssignee")
  deskGrants           DeskGrant[]
  deskReservations     DeskReservation[]
  deskReleases         DeskRelease[]
  deskApprovalRequests DeskApprovalRequest[] @relation("DeskApprovalRequester")
  decidedDeskApprovals DeskApprovalRequest[] @relation("DeskApprovalDecider")

  @@index([preferredParkingSpotId])
  @@index([preferredDeskId])
  @@index([officeId])
}

/// A physical parking spot. Retired spots are deactivated rather than deleted,
/// for the same foreign-key reason as users.
model ParkingSpot {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// Label painted on the spot, e.g. `E2.92`. Unique across the lot.
  label     String       @unique
  group     ParkingGroup
  active    Boolean      @default(true)
  /// Seen and booked by admins only.
  /// Not a retirement: a hidden spot stays bookable by an admin, for anybody.
  hidden    Boolean      @default(false)
  /// Has a charger for electric cars. Informational only, shown to everybody.
  evCharger Boolean      @default(false)
  /// Office whose users see and book this spot. Every existing spot was
  /// backfilled to Praha by the migration that introduced offices.
  officeId  String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reservations      Reservation[]
  waitlistEntries   WaitlistEntry[]
  timedReservations TimedReservation[]
  preferredBy       User[]             @relation("UserPreferredSpot")

  @@index([officeId])
}

/// One spot booked for one day, by exactly one holder: a user, or a guest.
///
/// The two unique constraints are the concurrency guarantee of the whole
/// reservation flow: `(parkingSpotId, date)` is what makes double-booking
/// impossible under concurrent requests, and The API maps its `P2002` violation
/// onto the contract error `SPOT_ALREADY_RESERVED`.
///
/// `userId` is nullable so that an admin can book for a guest, who has no `User`
/// row. `Reservation_holder_check` is what keeps that from admitting a row with
/// no holder at all —. Because `NULL`s do not collide
/// in a Postgres unique index, `(userId, date)` still means "one reservation per
/// user per day" and deliberately does not limit guests.
model Reservation {
  id            String   @id @default(uuid(7)) @db.Uuid
  parkingSpotId String   @db.Uuid
  userId        String?  @db.Uuid
  /// Set only for a guest reservation.
  guestName     String?
  /// Overrides the holder's stored plate for this day only; the only plate a
  /// guest can have.
  licensePlate  String?
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parkingSpotId, date])
  @@unique([userId, date])
  @@index([date])
}

/// A guest booked into a half-hour-granular block of one day, on one spot.
///
/// A separate model from `Reservation`, not a variant of it: a timed block is
/// always for a guest (no `userId`) and a spot may hold many of them on one
/// day, whereas `Reservation` is one-per-spot-per-day. Storage is minutes
/// since local midnight (`[startMinute, endMinute)`, half-open, multiples of
/// 30, `endMinute` up to `1440`), not the contract's `HH:MM` strings — see
/// `doc/backend.md`.
///
/// One (spot, day) is either one full-day `Reservation` or any number of
/// non-overlapping `TimedReservation` blocks, never both. Prisma's schema
/// language cannot express that exclusivity rule or the half-open-range
/// `CHECK`, so both live in the migration as hand-written SQL: a `CHECK` on
/// this table and a pair of triggers spanning both tables. See `doc/backend.md`.
model TimedReservation {
  id            String   @id @default(uuid(7)) @db.Uuid
  parkingSpotId String   @db.Uuid
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date          DateTime @db.Date
  /// Minutes after local midnight, inclusive. Multiple of 30.
  startMinute   Int      @db.SmallInt
  /// Minutes after local midnight, exclusive. Multiple of 30; 1440 = midnight.
  endMinute     Int      @db.SmallInt
  guestName     String
  licensePlate  String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([parkingSpotId, date])
  @@index([date])
}

/// A user waiting for an already-booked spot on a given day. Queue order is
/// `createdAt`, with `id` as the tiebreaker.
model WaitlistEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  parkingSpotId String   @db.Uuid
  userId        String   @db.Uuid
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parkingSpotId, userId, date])
  @@index([date])
  /// Covers the "who is next in line for this spot on this day" read.
  @@index([parkingSpotId, date, createdAt, id])
}

/// Append-only audit trail. Cancelling a reservation is a hard delete plus an
/// audit entry, so this table is what preserves the history. `UPDATE` and
/// `DELETE` are rejected by a database trigger created in the init migration.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Who performed the action. System actions are attributed to their trigger.
  actorUserId String         @db.Uuid
  action      AuditLogAction
  /// Entity kind the action applied to, e.g. `Reservation`.
  entityType  String
  entityId    String
  /// Free-form JSONB detail; its shape depends on `action`.
  payload     Json           @db.JsonB
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  // `onUpdate: Cascade` here is Prisma's default and it contradicts the
  // append-only trigger: a cascade fires `UPDATE "AuditLog"`, which
  // `auditlog_reject_mutation()` aborts, taking the whole transaction with it.
  // Left as Cascade on purpose. `User.id` is `@default(uuid(7))` and no code
  // path in this application updates a primary key, so the cascade is
  // unreachable; changing it to `NoAction` would be a truer declaration but
  // needs a fourth migration altering the constraint, and applying that to the
  // shared development database mid-review would desynchronise every other
  // worktree's migration history for a contradiction nothing can reach. Final
  // review M-4.
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

/// Singleton settings row driving the reservation window (decision 0004).
///
/// `id` is a fixed `Int`, not a UUID, and never leaves the database: the
/// contract's `reservationWindowSettingsSchema` has no `id` field at all. The
/// single-row property is enforced by `CHECK ("id" = 1)`, added by hand to the
/// init migration — Prisma's schema language cannot express a CHECK constraint.
/// See `doc/backend.md`.
model ReservationWindowSettings {
  id Int @id @default(1)

  /// How many days before the first of a month the month opens for booking.
  /// `CHECK` in the migration mirrors the contract's 1–31 bounds.
  openDaysBefore Int                 @default(7)
  /// Admin override of the automatic window.
  lockMode       ReservationLockMode @default(AUTO)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Singleton settings row holding the reservation limits.
///
/// Separate from `ReservationWindowSettings` rather than a column on it: that
/// model drives the *window* — whether a month is open to anybody — and a
/// per-user monthly quota is a different rule with a different audience. Its
/// name and doc comment say so, and a column that made both false is the kind
/// of defect this repo treats as real. Renaming that model instead would have
/// dragged `AuditLog.entityType` and `action` string values with it, leaving
/// the append-only audit table permanently disagreeing with itself.
///
///
/// Same singleton arrangement as its neighbour: `id` is a fixed `Int`, never
/// leaves the database (the contract's `reservationLimitSettingsSchema` has no
/// `id` field), and the single-row property is a `CHECK ("id" = 1)` added by
/// hand in the migration, because Prisma's schema language cannot express a
/// CHECK. See `doc/backend.md`.
model ReservationLimitSettings {
  id Int @id @default(1)

  /// How many confirmed reservations one user may hold in a calendar month.
  /// `CHECK` in the migration mirrors the contract's 1–31 bounds.
  monthlyReservationCap Int @default(5)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// --- Desks -----------------------------------------------------------------
// The desk-booking feature (`doc/desks.md`).
// Same conventions as the parking models above: uuid(7) ids, `DATE` days,
// `Timestamptz(3)` timestamps, `Restrict` on every foreign key that carries
// history. `Cascade` only on pure join rows (`HiveMembership`, `DeskGrant`)
// when the hive or desk they join is removed.

/// A branch office. Scopes desks, zones, parking spots and users
/// (decision 0323). Deactivated rather than deleted, like users and spots.
model Office {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  active          Boolean  @default(true)
  /// Name of a floor plan bundled with the web app
  /// (`apps/sit-and-park/web/public/floorplans/<floorPlan>.svg`), never a URL —
  /// decision 0325. Only `praha` exists.
  floorPlan       String?
  /// The plan's viewBox size, in the same units as `Desk.x`/`y`/`width`/`height`.
  floorPlanWidth  Int?
  floorPlanHeight Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  zones        Zone[]
  desks        Desk[]
  users        User[]
  parkingSpots ParkingSpot[]
}

/// A named area of one office's plan (decision 0324). Independent of hives.
model Zone {
  id       String @id @default(uuid(7)) @db.Uuid
  officeId String @db.Uuid
  /// Stable key from the floor plan, e.g. `engineering1`.
  key      String
  /// Display name. Data, so not translated.
  name     String

  office Office @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  desks  Desk[]

  @@unique([officeId, key])
}

/// A team owning a set of desks (decision 0322). Global, not office-scoped.
/// The owner decides approval requests for the hive's desks; that is the
/// owner's only power. `color` is `#RRGGBB`, enforced by a hand-written CHECK.
model Hive {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  color     String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships HiveMembership[]
  desks       Desk[]

  @@index([ownerId])
}

/// A user's membership of a hive. `userId` is unique: a user is in at most one
/// hive, and adding them to another moves them.
model HiveMembership {
  id        String   @id @default(uuid(7)) @db.Uuid
  hiveId    String   @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  hive Hive @relation(fields: [hiveId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([hiveId])
}

/// One bookable desk. Geometry is in floor-plan units: the axis-aligned box of
/// the desk's rectangle after every SVG transform is applied, generated once by
/// `src/scripts/generate-floor-plan-sql.ts` (decision 0325).
model Desk {
  id                  String   @id @default(uuid(7)) @db.Uuid
  officeId            String   @db.Uuid
  zoneId              String   @db.Uuid
  /// e.g. `D-001`. Unique per office.
  code                String
  active              Boolean  @default(true)
  /// Nullable: a desk outside any hive is open to everyone in its office.
  /// Removing a hive frees its desks rather than blocking the delete.
  hiveId              String?  @db.Uuid
  /// The permanent holder. Unique: at most one permanent desk per user.
  permanentAssigneeId String?  @unique @db.Uuid
  x                   Int
  y                   Int
  width               Int
  height              Int
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  office            Office @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  zone              Zone   @relation(fields: [zoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hive              Hive?  @relation(fields: [hiveId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  permanentAssignee User?  @relation("DeskPermanentAssignee", fields: [permanentAssigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  grants           DeskGrant[]
  reservations     DeskReservation[]
  releases         DeskRelease[]
  approvalRequests DeskApprovalRequest[]
  preferredBy      User[]                @relation("UserPreferredDesk")

  @@unique([officeId, code])
  @@index([zoneId])
  @@index([hiveId])
}

/// Direct permission for one user to book one hive desk without approval.
model DeskGrant {
  id        String   @id @default(uuid(7)) @db.Uuid
  deskId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  desk Desk @relation(fields: [deskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deskId, userId])
  @@index([userId])
}

/// One desk booked for one day by one user. The two uniques are the booking
/// guarantee (decision 0326); cancelling is a hard delete plus an audit entry,
/// as for parking.
model DeskReservation {
  id        String   @id @default(uuid(7)) @db.Uuid
  deskId    String   @db.Uuid
  userId    String   @db.Uuid
  /// Reservation day in Europe/Prague. `DATE`, never a timestamp.
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  desk Desk @relation(fields: [deskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deskId, date])
  @@unique([userId, date])
  @@index([date])
}

/// A day on which a permanent desk's holder has freed it; on that day the desk
/// is booked under the ordinary hive rules.
model DeskRelease {
  id           String   @id @default(uuid(7)) @db.Uuid
  deskId       String   @db.Uuid
  /// Released day in Europe/Prague. `DATE`, never a timestamp.
  date         DateTime @db.Date
  releasedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  desk       Desk @relation(fields: [deskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  releasedBy User @relation(fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deskId, date])
  @@index([date])
}

/// A request to book a hive desk for one day without direct access, decided by
/// the hive owner or an admin (decision 0332). At most one `PENDING` request per
/// (desk, user, date): a partial unique index, hand-written in the migration,
/// because Prisma's schema language cannot express its `WHERE`.
model DeskApprovalRequest {
  id          String             @id @default(uuid(7)) @db.Uuid
  deskId      String             @db.Uuid
  userId      String             @db.Uuid
  /// Requested day in Europe/Prague. `DATE`, never a timestamp.
  date        DateTime           @db.Date
  status      DeskApprovalStatus @default(PENDING)
  decidedById String?            @db.Uuid
  decidedAt   DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  desk      Desk  @relation(fields: [deskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User  @relation("DeskApprovalRequester", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedBy User? @relation("DeskApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, date])
  @@index([deskId, date])
  @@index([userId, date])
}

/// Log of every call of the employee sync, dry or live, accepted or rejected
/// (decision 0330). `summary` is JSONB; its shape is the contract's.
model EmployeeSyncRun {
  id        String             @id @default(uuid(7)) @db.Uuid
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  /// Caller-supplied label, e.g. `keboola`.
  source    String
  mode      EmployeeSyncMode
  status    EmployeeSyncStatus
  /// Why a `REJECTED` run was rejected; null for an `OK` run.
  reason    String?
  summary   Json               @db.JsonB

  @@index([createdAt])
}

/// Singleton settings row of the employee sync. The same arrangement as
/// `ReservationWindowSettings`: `id` is a fixed `Int` that never leaves the
/// database, the single row is a hand-written `CHECK ("id" = 1)`, and the
/// migration inserts it. The sync key is not stored here: only its SHA-256, in
/// the environment (decision 0330).
model EmployeeSyncSettings {
  id Int @id @default(1)

  /// Off by default: every run is a dry run until an admin switches this on.
  liveMode Boolean @default(false)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
